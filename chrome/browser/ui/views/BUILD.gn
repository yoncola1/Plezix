import("//build/config/ui.gni")
import("//ui/views/features.gni")

assert(toolkit_views)

component("views") {
  output_name = "browser_ui_views"
  sources = [
    "chrome_views_export.h",
    "chrome_widget_sublevel.h",
    "event_utils.cc",
    "event_utils.h",
    "tab_icon_view_model.h",
    "tab_search_bubble_host_observer.h",
    "tabs/shared/tab_strip_observer.cc",
    "tabs/shared/tab_strip_observer.h",
    "tabs/shared/tab_strip_types.h",

    # Полная и абсолютная сборка вертикальных табов
    "tabs/vertical/root_tab_collection_node.cc",
    "tabs/vertical/root_tab_collection_node.h",
    "tabs/vertical/tab_collection_animating_layout_manager.cc",
    "tabs/vertical/tab_collection_animating_layout_manager.h",
    "tabs/vertical/tab_collection_node.cc",
    "tabs/vertical/tab_collection_node.h",
    "tabs/vertical/tab_drag_scroll_handler.cc",
    "tabs/vertical/tab_drag_scroll_handler.h",
    "tabs/vertical/top_container_button.cc",
    "tabs/vertical/top_container_button.h",
    "tabs/vertical/vertical_dragged_tabs_container.cc",
    "tabs/vertical/vertical_dragged_tabs_container.h",
    "tabs/vertical/vertical_pinned_tab_container_view.cc",
    "tabs/vertical/vertical_pinned_tab_container_view.h",
    "tabs/vertical/vertical_split_tab_view.cc",
    "tabs/vertical/vertical_split_tab_view.h",
    "tabs/vertical/vertical_tab_drag_handler.cc",       # Поправил имя (без _impl)
    "tabs/vertical/vertical_tab_drag_handler.h",         # Поправил имя
    "tabs/vertical/vertical_tab_group_header_view.cc",   # Добавлено!
    "tabs/vertical/vertical_tab_group_header_view.h",     # Добавлено!
    "tabs/vertical/vertical_tab_group_view.cc",
    "tabs/vertical/vertical_tab_group_view.h",
    "tabs/vertical/vertical_tab_link_drop_handler.cc",   # Добавлено!
    "tabs/vertical/vertical_tab_link_drop_handler.h",     # Добавлено!
    "tabs/vertical/vertical_tab_strip_bottom_container.cc",
    "tabs/vertical/vertical_tab_strip_bottom_container.h",
    "tabs/vertical/vertical_tab_strip_controller.cc",
    "tabs/vertical/vertical_tab_strip_controller.h",
    "tabs/vertical/vertical_tab_strip_expand_on_hover_lock.cc",
    "tabs/vertical/vertical_tab_strip_expand_on_hover_lock.h",
    "tabs/vertical/vertical_tab_strip_scroll_bar.cc",
    "tabs/vertical/vertical_tab_strip_scroll_bar.h",
    "tabs/vertical/vertical_tab_strip_top_container.cc",
    "tabs/vertical/vertical_tab_strip_top_container.h",
    "tabs/vertical/vertical_tab_strip_utils.cc",
    "tabs/vertical/vertical_tab_strip_utils.h",
    "tabs/vertical/vertical_tab_strip_view.cc",
    "tabs/vertical/vertical_tab_strip_view.h",
    "tabs/vertical/vertical_tab_view.cc",
    "tabs/vertical/vertical_tab_view.h",
    "tabs/vertical/vertical_unpinned_tab_container_view.cc",
    "tabs/vertical/vertical_unpinned_tab_container_view.h",
  ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  defines = [ "CHROME_VIEWS_IMPLEMENTATION" ]

  public_deps = [ "//chrome/browser:browser_public_dependencies" ]

  deps = [
    "//base",
    "//build:branding_buildflags",
    "//chrome/app:command_ids",
    "//chrome/app:generated_resources",
    "//chrome/browser/ui:layout_constants",
    "//components/keep_alive_registry",
    "//components/lens",
    "//components/lens:buildflags",
    "//components/vector_icons",
    "//content/public/browser",
    "//printing/buildflags",
    "//services/screen_ai/buildflags",
    "//skia",
    "//ui/base",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
    "//url",
  ]

  if (is_chromeos) {
    deps += [
      "//ash",
      "//chromeos/ash/experiences/arc",
      "//chromeos/ash/experiences/arc/intent_helper",
    ]
  }
}

source_set("test_support") {
  testonly = true
  public = [ "global_media_controls/media_dialog_ui_for_test.h" ]
  sources = [ "global_media_controls/media_dialog_ui_for_test.cc" ]
  deps = [
    ":views",
    "//chrome/browser/media/router:test_support",
    "//chrome/browser/ui",
    "//chrome/browser/ui/global_media_controls",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/test:test_support_ui",
    "//components/global_media_controls",
    "//components/media_message_center",
    "//components/media_router/browser:test_support",
    "//testing/gtest",
    "//ui/base:test_support",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

source_set("file_system_access_test_support") {
  testonly = true
  sources = [
    "file_system_access/file_system_access_test_utils.cc",
    "file_system_access/file_system_access_test_utils.h",
  ]
  deps = [
    "//ui/shell_dialogs",
    "//url",
  ]
}
